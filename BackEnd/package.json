{
  "name": "riverview-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "align:prd": "node scripts/alignCatalogWithPrd.js",
    "align:prd:apply": "node scripts/alignCatalogWithPrd.js --apply",
    "align:catalog": "npm run align:prd",
    "align:catalog:apply": "npm run align:prd:apply",
    "restore:prd": "node scripts/restorePrdBackup.js",
    "restore:prd:apply": "node scripts/restorePrdBackup.js --apply",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^3.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "simple-statistics": "^7.9.3"
  }
}
