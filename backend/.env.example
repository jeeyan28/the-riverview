# Core configuration. Fill both required values before starting.
NODE_ENV=development
PORT=3000
MONGO_URI=
SESSION_SECRET=

# Exact frontend origins, comma-separated; no trailing slash or path.
APP_BASE_URL=http://localhost:5501
# Optional frontend URL used in email links.
APP_PUBLIC_URL=http://localhost:5501

# Gmail app password for verification, recovery, receipts, notifications.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Google OAuth; client ID must match frontend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for PayMongo checkout. Keep test/live credentials consistent.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_API_BASE=https://api.paymongo.com/v1
PAYMONGO_RETURN_BASE_URL=http://localhost:5501

# Optional Xendit fallback; return URL must be a public HTTPS frontend URL.
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_RETURN_BASE_URL=

# Required for authenticated reservation jobs on serverless hosting.
CRON_SECRET=
