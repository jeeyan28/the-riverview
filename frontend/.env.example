# Empty uses /api on the same origin through Vite / Vercel.
VITE_API_URL=

# Optional public Google client ID. Match the backend OAuth client ID.
VITE_GOOGLE_CLIENT_ID=

# Optional public endpoint override.
VITE_PAYMONGO_API_BASE=https://api.paymongo.com/v1

# VITE_ values are public. Never place backend secrets in this file.
